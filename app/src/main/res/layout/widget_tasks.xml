<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Today"
                android:textColor="#FFF4F1EA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFA8A397"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_list"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_round_btn"
            android:contentDescription="Open Cadence"
            android:padding="9dp"
            android:src="@drawable/ic_w_pencil" />

        <ImageView
            android:id="@+id/w_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_round_btn_accent"
            android:contentDescription="New task"
            android:padding="9dp"
            android:src="@drawable/ic_w_plus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/w_chk1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Mark done"
            android:padding="6dp"
            android:src="@drawable/widget_chk" />

        <TextView
            android:id="@+id/w_title1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFF4F1EA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_time1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFF2B04A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/w_chk2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Mark done"
            android:padding="6dp"
            android:src="@drawable/widget_chk" />

        <TextView
            android:id="@+id/w_title2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFF4F1EA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFF2B04A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/w_chk3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Mark done"
            android:padding="6dp"
            android:src="@drawable/widget_chk" />

        <TextView
            android:id="@+id/w_title3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFF4F1EA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_time3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFF2B04A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="All clear"
        android:textColor="#FFA8A397"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
