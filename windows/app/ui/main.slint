// Cadence for Windows: dark, amber, one list.

struct TaskItem {
    uuid: string,
    title: string,
    time-top: string,
    time-bottom: string,
    sub: string,
    priority: int,
    done: bool,
    overdue: bool,
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    callback clicked;
    height: 32px;
    border-radius: 16px;
    background: accent ? #F2B04A : (ta.has-hover ? #262626 : #1b1b1b);
    min-width: label.preferred-width + 28px;
    label := Text {
        text: root.text;
        color: root.accent ? #1a1204 : #d9d4c9;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Row inherits Rectangle {
    in property <TaskItem> item;
    callback toggle;
    callback remove;
    callback edit;
    height: 64px;
    background: ta.has-hover ? #121212 : transparent;

    ta := TouchArea { clicked => { root.edit(); } }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 12px;
        spacing: 10px;
        alignment: stretch;

        VerticalLayout {
            width: 54px;
            alignment: center;
            Text {
                text: root.item.time-top;
                horizontal-alignment: right;
                font-size: 13px;
                font-weight: 700;
                color: root.item.done ? #6f6b63 : (root.item.overdue ? #ff7a70 : #b9b4a8);
            }
            Text {
                text: root.item.time-bottom;
                horizontal-alignment: right;
                font-size: 10px;
                color: #6f6b63;
            }
        }

        // the dot: click to complete
        Rectangle {
            width: 32px;
            TouchArea { clicked => { root.toggle(); } mouse-cursor: pointer; }
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.item.done ? #6f6b63 : (root.item.overdue ? #ff7a70 : transparent);
                border-width: root.item.done || root.item.overdue ? 0px : 2px;
                border-color: root.item.priority == 3 ? #ff7a70 : (root.item.priority == 2 ? #F2B04A : (root.item.priority == 1 ? #7fb88a : #6f6b63));
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.title;
                color: root.item.done ? #6f6b63 : #f3efe6;
                font-size: 16px;
                overflow: elide;
            }
            Text {
                text: root.item.sub;
                color: #77736a;
                font-size: 12px;
                overflow: elide;
            }
        }

        Rectangle {
            width: 28px;
            Text {
                text: "×";
                font-size: 20px;
                color: del.has-hover ? #ff7a70 : #55524b;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            del := TouchArea { clicked => { root.remove(); } mouse-cursor: pointer; }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #161616;
    }
}

export component MainWindow inherits Window {
    title: "Cadence";
    icon: @image-url("../../../docs/icon.png");
    background: #0a0a0a;
    min-width: 360px;
    min-height: 480px;
    preferred-width: 440px;
    preferred-height: 720px;
    default-font-size: 14px;

    in property <string> date-line;
    in property <string> heading;
    in property <string> sub-heading;
    in property <[TaskItem]> tasks;
    in property <string> sync-text;
    in property <bool> sync-error;
    in property <bool> sync-on;
    in property <string> folder-text;
    in-out property <bool> show-sync: false;
    in-out property <bool> show-done: true;
    // editing
    in-out property <string> editing-uuid: "";
    in-out property <string> edit-title;

    callback add(string);
    callback toggle(string);
    callback remove(string);
    callback rename(string, string);
    callback cycle-priority(string);
    callback pick-folder();
    callback stop-sync();
    callback sync-now();

    VerticalLayout {
        padding-left: 20px;
        padding-right: 14px;
        padding-top: 18px;
        padding-bottom: 14px;
        spacing: 12px;

        HorizontalLayout {
            VerticalLayout {
                spacing: 2px;
                Text { text: root.date-line; color: #F2B04A; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
                Text { text: root.heading; color: #f3efe6; font-size: 32px; font-weight: 800; }
                Text { text: root.sub-heading; color: #8a867c; font-size: 13px; }
            }
            Rectangle { }
            Pill {
                y: 4px;
                text: root.sync-on ? "Sync" : "Set up sync";
                clicked => { root.show-sync = !root.show-sync; }
            }
        }

        if root.show-sync: Rectangle {
            background: #141414;
            border-radius: 14px;
            border-width: 1px;
            border-color: #232323;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Text {
                    text: "Sync with your phone";
                    color: #f3efe6;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {
                    text: "Pick the same folder the phone uses (Settings, Backup and restore, Sync with a computer). It can be a Syncthing, OneDrive or Google Drive folder.";
                    color: #8a867c;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.sync-on ? root.folder-text : "No folder chosen";
                    color: #d9d4c9;
                    font-size: 12px;
                    overflow: elide;
                }
                if root.sync-error: Text {
                    text: root.sync-text;
                    color: #ff7a70;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if !root.sync-error && root.sync-on: Text {
                    text: root.sync-text;
                    color: #7fb88a;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Pill { text: root.sync-on ? "Change folder" : "Choose folder"; accent: !root.sync-on; clicked => { root.pick-folder(); } }
                    if root.sync-on: Pill { text: "Sync now"; clicked => { root.sync-now(); } }
                    if root.sync-on: Pill { text: "Turn off"; clicked => { root.stop-sync(); } }
                }
            }
        }

        // the list
        Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                alignment: start;
                for t[i] in root.tasks: Row {
                    item: t;
                    toggle => { root.toggle(t.uuid); }
                    remove => { root.remove(t.uuid); }
                    edit => { root.editing-uuid = t.uuid; root.edit-title = t.title; }
                }
                if root.tasks.length == 0: Rectangle {
                    height: 90px;
                    Text {
                        text: "Nothing here yet. Type a task below.";
                        color: #6f6b63;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // edit bar (appears when a row is clicked)
        if root.editing-uuid != "": Rectangle {
            height: 48px;
            background: #141414;
            border-radius: 14px;
            border-width: 1px;
            border-color: #F2B04A;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 8px;
                edit-input := TextInput {
                    init => { self.focus(); }
                    text <=> root.edit-title;
                    color: #f3efe6;
                    font-size: 15px;
                    vertical-alignment: center;
                    accepted => {
                        root.rename(root.editing-uuid, root.edit-title);
                        root.editing-uuid = "";
                    }
                }
                Pill { y: 8px; text: "Priority"; clicked => { root.cycle-priority(root.editing-uuid); } }
                Pill { y: 8px; text: "Save"; accent: true; clicked => { root.rename(root.editing-uuid, root.edit-title); root.editing-uuid = ""; } }
                Pill { y: 8px; text: "Cancel"; clicked => { root.editing-uuid = ""; } }
            }
        }

        // new task
        Rectangle {
            height: 48px;
            background: #f3efe6;
            border-radius: 24px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                Rectangle {
                    Text {
                        visible: new-input.text == "";
                        text: "+  New task   (try: Call mom tomorrow 6pm !!)";
                        color: #77736a;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                    new-input := TextInput {
                        color: #141414;
                        font-size: 16px;
                        vertical-alignment: center;
                        accepted => {
                            if (self.text != "") {
                                root.add(self.text);
                                self.text = "";
                            }
                        }
                    }
                }
            }
        }
    }
}
